# Frontend Environment Configuration
# ===================================
# MIXMIND works 100% client-side with Web Audio DSP + Vercel serverless proxy.
# No secrets or API keys are required for core playback or YouTube playlist extraction.

PORT=3000

# Optional: Python/FastAPI + Librosa track analysis backend URL
# When unset or offline, MIXMIND falls back seamlessly to client-side BPM & Camelot metadata.
# VITE_API_URL=https://your-mixmind-backend.onrender.com
