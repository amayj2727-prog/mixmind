# MIXMIND Environment Configuration
# ==================================
# Note: MIXMIND is fully functional out-of-the-box without any mandatory environment variables!
# Web Audio DSP, beatmatching, and playlist parsing run client-side in the browser.

# Optional: Port configuration for local production server
PORT=3000

# Optional: Host URL (if hosting behind custom domain or reverse proxy)
# VITE_APP_URL=https://your-domain.vercel.app
