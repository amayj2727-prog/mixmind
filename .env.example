# MIXMIND Environment Configuration
# ==================================
# No secret API keys are required for core playback or YouTube playlist extraction.

# Backend API Server Port (used by Render, Railway, Fly.io, and local uvicorn)
PORT=8000

# Comma-separated CORS origins allowed by the FastAPI audio analysis backend
# Supports exact URLs and wildcard subdomains like https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app

# Optional: Max seconds of audio analyzed per upload by Librosa (default: 45.0)
# ANALYSIS_WINDOW_SECONDS=45.0
